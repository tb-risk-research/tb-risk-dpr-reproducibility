{
  "description": "结核病临床文本正则抽取模板 — 按优先级排序，10=最高",
  "templates": [
    {
      "pattern": "年龄[约为]?(\\d{1,3})[岁周岁]",
      "field": "age",
      "transform": "int",
      "priority": 10
    },
    {
      "pattern": "痰涂片(阳性|阴性|涂阳|涂阴|\\+\\+|--)",
      "field": "sputum_smear",
      "transform": "clinical",
      "priority": 10
    },
    {
      "pattern": "痰[检涂]片?[结]?果?[为是：:]\\s*(阳性|阴性|涂阳|涂阴)",
      "field": "sputum_smear",
      "transform": "clinical",
      "priority": 9
    },
    {
      "pattern": "痰检[：:]\\s*(阳性|阴性|涂阳|涂阴)",
      "field": "sputum_smear",
      "transform": "clinical",
      "priority": 9
    },
    {
      "pattern": "(有|无|存在|未见|可见)空洞",
      "field": "has_cavity",
      "transform": "bool",
      "priority": 10
    },
    {
      "pattern": "肺部.?[CTct]?[：:示见]?.*?(空洞|cavity)",
      "field": "has_cavity",
      "transform": "clinical",
      "priority": 8
    },
    {
      "pattern": "卡介苗[接种]*(已接种|未接种|有|无|是|否)",
      "field": "bcg_vaccine",
      "transform": "bool",
      "priority": 10
    },
    {
      "pattern": "BCG[接种]*(已接种|未接种|有|无|是|否|yes|no)",
      "field": "bcg_vaccine",
      "transform": "bool",
      "priority": 9
    },
    {
      "pattern": "(咳嗽|咳)[\\s\\S]{0,5}(频繁|剧烈|轻度|偶尔|无)",
      "field": "cough_freq",
      "transform": "rating",
      "priority": 8
    },
    {
      "pattern": "咳嗽[频率频次]*[约为]?(\\d{1,3})[次下]",
      "field": "cough_freq",
      "transform": "int",
      "priority": 7
    },
    {
      "pattern": "(已[经曾]?|未[经曾]?|正在|接受|未接受)治疗",
      "field": "treatment",
      "transform": "clinical",
      "priority": 10
    },
    {
      "pattern": "治疗[时长时间]*[约为]?(\\d{1,2})[个]?月",
      "field": "treatment_duration",
      "transform": "int",
      "priority": 9
    },
    {
      "pattern": "通风[条件状况情况]*[：:]*\\s*(极差|差|一般|好|极好|良好|较差|不好)",
      "field": "ventilation",
      "transform": "rating",
      "priority": 9
    },
    {
      "pattern": "接触[距离]*[：:]*\\s*(极近|近|中等|远|极远|近距离|远距离)",
      "field": "contact_distance",
      "transform": "distance",
      "priority": 9
    },
    {
      "pattern": "(场所|环境)[：:]*\\s*(拥挤|密闭|一般|户外|油田|营地)",
      "field": "exposure_setting",
      "transform": "setting",
      "priority": 8
    },
    {
      "pattern": "(男性|女性|男|女|male|female)",
      "field": "gender",
      "transform": "gender",
      "priority": 9
    },
    {
      "pattern": "(汉族|维吾尔族|哈萨克族|回族|蒙古族|藏族|其他)",
      "field": "ethnicity",
      "transform": "str",
      "priority": 8
    },
    {
      "pattern": "[曾既]往[有患]?(结核|肺结核|TB)",
      "field": "has_tb",
      "transform": "bool_positive",
      "priority": 9
    },
    {
      "pattern": "该患者[\\s\\S]{0,30}(曾患|有|既往|三年前|两年前).*?结核",
      "field": "has_tb",
      "transform": "clinical",
      "priority": 7
    },
    {
      "pattern": "BMI[为是]?[约]?(\\d{1,2}(\\.\\d)?)",
      "field": "bmi",
      "transform": "float",
      "priority": 6
    },
    {
      "pattern": "体重?(\\d{2,3})\\s*(kg|公斤|千克)",
      "field": "weight",
      "transform": "float",
      "priority": 5
    },
    {
      "pattern": "(\\d{1,2})\\s*[岁岁数]",
      "field": "age",
      "transform": "int",
      "priority": 8
    },
    {
      "pattern": "(症状|症状严重程度)[：:]*\\s*(1|2|3|4|极差|差|一般|好|极好)",
      "field": "symptoms",
      "transform": "rating",
      "priority": 8
    },
    {
      "pattern": "延迟就诊[约为]?(\\d{1,3})[天日]",
      "field": "delay_days",
      "transform": "int",
      "priority": 8
    },
    {
      "pattern": "居住[条件环境]*[：:]*\\s*(极差|差|一般|好|极好|较差|良好)",
      "field": "family_living_conditions",
      "transform": "rating",
      "priority": 8
    }
  ]
}